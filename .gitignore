# Python
__pycache__/
*.pyc
*.pyo

# Env / secrets
.env
.env.*

# OS / editor cruft
.DS_Store
.ipynb_checkpoints/

# Eval outputs (run locally; not versioned)
**/eval_results_low_detail/

# Representation_Analysis: trained-model checkpoints (~3.9 GB)
experiments/shared_utils/feature_extraction/checkpoints/**/ckpt/

# Feature cache for `run.py metrics --cache` runs (~14 GB)
.features_cache/

# Downloaded dataset payloads (populated by datasets/download_datasets.py;
# don't commit the data, just the .gitkeep + drop-point READMEs).
datasets/Existing_Datasets/Classification/CIFAR-100/cifar-100-python/
datasets/Existing_Datasets/Classification/CIFAR-100/cifar-100-python.tar.gz
datasets/Existing_Datasets/Classification/Caltech-101/caltech101/
datasets/Existing_Datasets/Classification/Food-101/food-101/
datasets/Existing_Datasets/Classification/Food-101/food-101.tar.gz
datasets/Existing_Datasets/Classification/GTSRB/gtsrb/
datasets/Existing_Datasets/Classification/ImageNet-1K/imagenet_hf/
datasets/Existing_Datasets/Keypoint_Matching/SPair-71K/SPair-71k/
datasets/Existing_Datasets/Retrieval/Flickr30K/*
!datasets/Existing_Datasets/Retrieval/Flickr30K/.gitkeep
datasets/Existing_Datasets/Segmentation/ADE20K/ADEChallengeData2016/
datasets/Existing_Datasets/Segmentation/PASCAL_VOC/VOCdevkit/
datasets/Existing_Datasets/Segmentation/PASCAL_Context/VOCtrainval_03-May-2010.tar
datasets/Existing_Datasets/Segmentation/PASCAL_Context/trainval_merged.json
datasets/Existing_Datasets/Segmentation/PASCAL_Context/VOCdevkit/
datasets/Existing_Datasets/Segmentation/COCO_Stuff/images/
datasets/Existing_Datasets/Segmentation/COCO_Stuff/annotations/
datasets/Existing_Datasets/Segmentation/Cityscapes/gtFine/
datasets/Existing_Datasets/Segmentation/Cityscapes/leftImg8bit/
datasets/Existing_Datasets/Vision_Language_Alignment/MS-COCO-2014/train2014/
datasets/Existing_Datasets/Vision_Language_Alignment/MS-COCO-2014/val2014/
datasets/Existing_Datasets/Vision_Language_Alignment/MS-COCO-2014/annotations/
datasets/Existing_Datasets/Vision_Language_Alignment/Recaptioned_LAION/data/

# Vision_Language_Alignment: trained alignment-head checkpoints + tensorboard logs
experiments/Vision_Language_Alignment/training/checkpoints/
experiments/Vision_Language_Alignment/training/logs/

# Segmentation: trained head checkpoints + tensorboard logs (gitignored)
experiments/Segmentation/training/checkpoints/
experiments/Segmentation/training/logs/

# ImageNet_Classification: cached pooled feature memmaps (per-backbone, fp16)
experiments/ImageNet_Classification/features/

# Puzzle_Perception segmentation dataset (downloaded by download_datasets.py)
datasets/Puzzle_Perception/Segmentation/data/

# One-off helper scripts (run locally; not part of the released code)
scripts/

# Locally-supplied / superseded heavy data (~520 MB). Never committed — only the
# drop-point README and .gitkeep are tracked. Holds the legacy 269-sample chess
# seg-eval set (real boards, per-pixel masks, overlay jpgs, text_repr.json), still
# needed by the Puzzle_Understanding chess seg track, the VLA chess-localization
# track and CRG chess board regeneration; plus the archived pre-restructure CRG
# scratch tree. Relocate with EXPERIMENTS_LOCAL_DATA_ROOT.
datasets/_local/*
!datasets/_local/README.md
!datasets/_local/.gitkeep

# CRG experiment: run logs and scratch runs only. The dataset (board images +
# questions.yaml + answers.csv + cached TDDN detections) is committed under
# datasets/Puzzle_Perception/PVQA/{chess,nqueens}/, and so are the per-model
# per-question result JSONs. Runs without --publish land in results/*/_live/.
experiments/CRG/evaluation/results/**/*.log
experiments/CRG/evaluation/results/*/_live/*
!experiments/CRG/evaluation/results/*/_live/.gitkeep

# Vision_Language_Alignment: same _live/ convention as CRG above — runs without
# --publish land here so a smoke test can't overwrite a paper number.
experiments/Vision_Language_Alignment/evaluation/results/*/_live/*
!experiments/Vision_Language_Alignment/evaluation/results/*/_live/.gitkeep

# Representation_Analysis alignment/cross_prediction: run logs, cached feature
# matrices (multi-hundred-MB .npz), intermediate item/stem manifests, and the
# downloaded ImageNet sample JPEGs used to compute them. The CSV/JSON results
# themselves are committed.
experiments/Representation_Analysis/quantitative/*/results/*.log
experiments/Representation_Analysis/quantitative/*/results/*.npz
experiments/Representation_Analysis/quantitative/*/results/_*.tsv
experiments/Representation_Analysis/quantitative/*/results/_*.txt
experiments/Representation_Analysis/quantitative/*/results/imagenet_jpg/
